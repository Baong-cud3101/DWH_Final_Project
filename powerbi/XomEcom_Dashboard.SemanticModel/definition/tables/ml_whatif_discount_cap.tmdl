	partition ml_whatif_discount_cap = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "ml_whatif_discount_cap.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"cap", type number}, {"rows_affected", Int64.Type}, {"pred_profit_baseline", type number}, {"pred_profit_capped", type number}, {"uplift", type number}, {"uplift_pct", type number}, {"pred_margin_capped", type number}}, "en-US"),
				    Added0 = Table.AddColumn(Typed, "cap_label", each "Trần " & Text.From(Number.Round([cap] * 100)) & "%", type text)
				in
				    Added0

	annotation PBI_ResultType = Table
