	partition mart_kpi_overview = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "mart_kpi_overview.csv"), [Delimiter = ",", Columns = 12, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}, {"revenue", type number}, {"profit", type number}, {"profit_margin", type number}, {"implied_cost", type number}, {"total_orders", Int64.Type}, {"avg_order_value", type number}, {"loss_line_rate", type number}, {"deep_discount_share", type number}, {"total_lines", Int64.Type}, {"active_customers", Int64.Type}, {"repeat_customer_rate", type number}}, "en-US"),
				    Filtered = Table.SelectRows(Typed, each [year] <> 0)
				in
				    Filtered

	annotation PBI_ResultType = Table
