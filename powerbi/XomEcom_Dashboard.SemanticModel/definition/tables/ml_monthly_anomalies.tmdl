	partition ml_monthly_anomalies = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "ml_monthly_anomalies.csv"), [Delimiter = ",", Columns = 12, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"month_start", type datetime}, {"revenue", type number}, {"profit", type number}, {"margin", type number}, {"fitted_profit", type number}, {"residual", type number}, {"z_score", type number}, {"is_residual_anomaly", type logical}, {"lower_95", type number}, {"upper_95", type number}, {"below_2023_interval", type logical}, {"is_anomaly", type logical}}, "en-US")
