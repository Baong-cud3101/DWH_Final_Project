table _Measures
	lineageTag: a8d3a7e2-bbb0-59b5-ba52-20010fde7fce

	measure Revenue = SUM(mart_segment_profitability[revenue])
		formatString: #,0
		lineageTag: cb43177f-2e46-5923-b4a1-1ceb05915c54

	measure Profit = SUM(mart_segment_profitability[profit])
		formatString: #,0
		lineageTag: 040acb5a-c9e5-5505-991c-e62493b5ac55

	measure 'Profit Margin' = DIVIDE([Profit], [Revenue])
		formatString: 0.0%
		lineageTag: eab38105-2c95-51ba-a96b-ed62ce55be02

	measure 'Implied Cost' = [Revenue] - [Profit]
		formatString: #,0
		lineageTag: 0b0ff236-5864-54da-9cd8-32a0efe07dca

	measure Orders = IF(ISFILTERED(DimMarket[market]) || ISFILTERED(DimSegment[segment]), SUM(mart_segment_profitability[total_orders]), SUM(mart_kpi_overview[total_orders]))
		formatString: #,0
		lineageTag: f105470a-cf38-54eb-bcbb-91bd592c2b04

	measure AOV = DIVIDE([Revenue], [Orders])
		formatString: #,0.00
		lineageTag: c89a8573-4f11-50e1-bf46-5b2697c0240d

	measure 'Repeat Rate' = IF(ISFILTERED(DimYear[year]), IF(HASONEVALUE(DimYear[year]), MAX(mart_kpi_overview[repeat_customer_rate])), [Customer Repeat Rate])
		formatString: 0.0%
		lineageTag: 8942bd3e-ad2e-55cf-a0e8-768a56337cb6

	measure 'Margin LY' = VAR y = MAX(DimYear[year]) RETURN CALCULATE([Profit Margin], DimYear[year] = y - 1)
		formatString: 0.0%
		lineageTag: dcefddf1-0db4-561b-9edb-8bbb52df67d0

	measure 'Margin Change' = [Profit Margin] - [Margin LY]
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: a1d9e980-5c6c-5920-a1ba-f3df1166eef9

	measure 'Actual Profit' = CALCULATE(SUM(ml_forecast_monthly[profit]), ml_forecast_monthly[kind] = "actual")
		formatString: #,0
		lineageTag: 926451a9-2c72-5d33-8c6d-2d1ee626fcb6

	measure 'Forecast Profit' = CALCULATE(SUM(ml_forecast_monthly[profit]), ml_forecast_monthly[kind] = "forecast")
		formatString: #,0
		lineageTag: 14ecc86b-5f7a-52cd-8d26-1ca348e71e86

	measure 'Anomaly Profit' = CALCULATE(SUM(ml_monthly_anomalies[profit]), ml_monthly_anomalies[is_anomaly] = TRUE())
		formatString: #,0
		lineageTag: 226b96df-5a81-5316-ac16-d255da2a7683

	measure 'Disc Revenue' = SUM(mart_discount_analysis[revenue])
		formatString: #,0
		lineageTag: 43c8ccb8-0d75-59f2-b24f-a1e69cd5c6e6

	measure 'Disc Margin' = DIVIDE(SUM(mart_discount_analysis[profit]), SUM(mart_discount_analysis[revenue]))
		formatString: 0.0%
		lineageTag: af43bce2-881b-57be-8f4c-32e71eacdc88

	measure 'Disc Loss Line Rate' = DIVIDE(SUM(mart_discount_analysis[loss_lines]), SUM(mart_discount_analysis[total_lines]))
		formatString: 0.0%
		lineageTag: 300e679c-de80-5748-a4c2-727958421c97

	measure 'Cap Profit Baseline' = SUM(ml_whatif_discount_cap[pred_profit_baseline])
		formatString: #,0
		lineageTag: 31e8911f-9e40-5d21-9117-c5c0446acb33

	measure 'Cap Profit Capped' = SUM(ml_whatif_discount_cap[pred_profit_capped])
		formatString: #,0
		lineageTag: 9c181f62-2375-5c2c-b71a-448541a8c9cf

	measure 'Cap Uplift %' = AVERAGE(ml_whatif_discount_cap[uplift_pct])
		formatString: 0.0%
		lineageTag: 00677271-727e-5221-bb1e-7eefa3d01d88

	measure 'WhatIf Margin' = DIVIDE(SUM(ml_whatif_discount[pred_profit]), SUM(ml_whatif_discount[sales]))
		formatString: 0.0%
		lineageTag: 402ba1dc-8cda-54fc-a559-6b64b87a4f8e

	measure 'Geo Revenue' = SUM(mart_geographic_performance[revenue])
		formatString: #,0
		lineageTag: 538f8e57-e58e-5159-abc9-31c46905813a

	measure 'Geo Profit' = SUM(mart_geographic_performance[profit])
		formatString: #,0
		lineageTag: 235b235f-3b68-5d5b-b88e-914b99c25f60

	measure 'Geo Margin' = DIVIDE([Geo Profit], [Geo Revenue])
		formatString: 0.0%
		lineageTag: 5a852627-d709-5df0-9c3f-61c039dbbdf2

	measure 'Geo Margin 2022' = CALCULATE([Geo Margin], DimYear[year] = 2022)
		formatString: 0.0%
		lineageTag: ce477123-351b-5745-b95e-ffb0cfe08ebe

	measure 'Geo Margin 2023' = CALCULATE([Geo Margin], DimYear[year] = 2023)
		formatString: 0.0%
		lineageTag: 50133429-23e3-5a79-ba96-fb12b7354ef3

	measure 'Geo Growth' = VAR y = MAX(DimYear[year]) RETURN DIVIDE(CALCULATE([Geo Revenue], DimYear[year] = y), CALCULATE([Geo Revenue], DimYear[year] = y - 1)) - 1
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: cd36f78d-d6c7-50df-b90e-2482a3348b14

	measure 'Geo Growth 2023' = CALCULATE([Geo Growth], DimYear[year] = 2023)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 511ec53d-e908-5648-92e7-09bf7342d461

	measure Customers = COUNTROWS(mart_customer_value)
		formatString: #,0
		lineageTag: 2ed92d48-34e4-5236-b208-4395d2fe145b

	measure 'Avg Recency' = AVERAGE(mart_customer_value[recency_days])
		formatString: #,0
		lineageTag: d0ad56fe-dd21-5ac1-9820-788ce1f76aa1

	measure 'Avg Frequency' = AVERAGE(mart_customer_value[frequency])
		formatString: 0.00
		lineageTag: 361930fa-280f-5cb2-a2d6-3bd568ed9c7e

	measure 'Avg Monetary' = AVERAGE(mart_customer_value[monetary])
		formatString: #,0
		lineageTag: f19d0e9d-eea2-51d6-839b-5c339c98f216

	measure 'Customer Margin' = DIVIDE(SUM(mart_customer_value[profit]), SUM(mart_customer_value[monetary]))
		formatString: 0.0%
		lineageTag: 8de1fb75-d4d6-565e-bc17-33fa856473e8

	measure 'Customer Repeat Rate' = DIVIDE(CALCULATE(COUNTROWS(mart_customer_value), mart_customer_value[is_repeat_customer] = TRUE()), COUNTROWS(mart_customer_value))
		formatString: 0.0%
		lineageTag: dea5961c-b092-5304-94d6-7e2b586ccb4e

	measure 'Profit Share' = DIVIDE(SUM(mart_customer_value[profit]), CALCULATE(SUM(mart_customer_value[profit]), ALLSELECTED(mart_customer_value[cluster_name])))
		formatString: 0.0%
		lineageTag: c98fc98a-a7b5-5e9a-b99e-f3f4bd99349a

	measure Retention = AVERAGE(mart_customer_cohort[retention_rate])
		formatString: 0.0%
		lineageTag: 2b8eacba-5d17-58db-8c2c-36c8afff5b92

	measure 'Customers C0' = CALCULATE(COUNTROWS(mart_customer_value), KEEPFILTERS(mart_customer_value[cluster] = 0))
		formatString: #,0
		lineageTag: 18d80566-0b36-5ce6-8132-becc96927d35

	measure 'Customers C1' = CALCULATE(COUNTROWS(mart_customer_value), KEEPFILTERS(mart_customer_value[cluster] = 1))
		formatString: #,0
		lineageTag: 383f654b-d105-522c-a19e-e1bcb6b9228d

	measure 'Customers C2' = CALCULATE(COUNTROWS(mart_customer_value), KEEPFILTERS(mart_customer_value[cluster] = 2))
		formatString: #,0
		lineageTag: 91826253-7e00-5617-9f6d-44372efc27ed

	measure 'Customers C3' = CALCULATE(COUNTROWS(mart_customer_value), KEEPFILTERS(mart_customer_value[cluster] = 3))
		formatString: #,0
		lineageTag: f087d4b1-70af-5463-bd07-fbf8d7fc3a87

	column Dummy
		dataType: string
		isHidden
		lineageTag: 74fa1e62-477a-5b72-b55b-110c469c3051
		summarizeBy: none
		sourceColumn: Dummy

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Dummy = text], {})
				in
				    Source

	annotation PBI_ResultType = Table
